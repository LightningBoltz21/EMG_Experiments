/ {
    /* Defines for custom pins that aren't part of a standard protocol */
    zephyr,user {
        /* * ADS1298 /RESET pin.
         * Moved to P1.11 (Arduino D3) to avoid conflicts.
         */
        ads-reset-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;

        /* * ADS1298 DRDY pin.
         * Moved to P1.10 (Arduino D2).
         */
        ads-drdy-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
    };
};

/* Disable other peripherals that might conflict */
&i2c1 {	status = "disabled";};
&spi4 { status = "disabled";};

/* PWM0 generates the ADS1298 master clock on P1.04 (2 MHz, 50% duty) */
&pwm0 {
        status = "okay";
        pinctrl-0 = <&pwm0_default>;
        pinctrl-1 = <&pwm0_sleep>;
        pinctrl-names = "default", "sleep";
};

&spi1 {
        compatible = "nordic,nrf-spim";
        status = "okay";

        /* CS moved to P1.12 (Arduino D10) */
        cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;

        pinctrl-0 = <&spi1_default>;
        pinctrl-1 = <&spi1_sleep>;
        pinctrl-names = "default", "sleep";

        gendev: gendev@0 {
                compatible = "vnd,spi-device";
                reg = <0>;
                spi-max-frequency = <1000000>;
                label = "GenDev";
        };
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            /* Arduino D13 (SCK), D11 (MOSI), D12 (MISO) */
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
        };
    };
    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };

    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
        };
    };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 4)>;
            low-power-enable;
        };
    };
};


/*

MOSI:  P1.13 ---------- DIN
MISO:  P1.14 ---------- DOUT
CS:    P1.12 ---------- CS
Clock: P1.15 ---------- SCLK
RESET: P1.11
DRDY : P1.10
CLK:    P1.04 (2 MHz PWM from nRF)
CLKSEL: VDD (external clock mode)


Power: J4-ADS-PDK ----------- MB00-J5

*/
